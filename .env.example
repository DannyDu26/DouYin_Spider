# FastAPI 只读取此处的 APP_ENV，再加载 .env.dev 或 .env.prod
APP_ENV=dev

# 以下凭证仅供 scripts/legacy_cli.py 与旧版直播入口使用，FastAPI 不读取
DY_COOKIES=''
DY_LIVE_COOKIES=''
DY_TICKET=''
DY_TS_SIGN=''
DY_CLIENT_CERT=''
DY_PRIVATE_KEY=''

# FastAPI 请改用 .env.dev.example 或 .env.prod.example

# 小红书 PC API：启用前先将 crawler_cookie.remark 扩为 TEXT
XHS_ENABLED=true
XHS_MAX_CONCURRENT_REQUESTS=1
XHS_ACCOUNT_COOLDOWN_SECONDS=900
# 小红书业务请求统一节流：完成后等待 5～10 秒；入口和传输阶段各使用 30 秒等待预算。
XHS_REQUEST_INTERVAL_SECONDS=5
XHS_REQUEST_JITTER_SECONDS=5
XHS_REQUEST_QUEUE_TIMEOUT_SECONDS=30
XHS_UPSTREAM_MAX_RETRIES=2
XHS_UPSTREAM_BACKOFF_SECONDS=5
XHS_UPSTREAM_BACKOFF_MAX_SECONDS=60
XHS_SNAPSHOT_INTERVAL_SECONDS=60
XHS_SMS_SESSION_TIMEOUT_SECONDS=300
XHS_SMS_SESSION_RETENTION_SECONDS=300
XHS_SMS_RESEND_INTERVAL_SECONDS=60
XHS_SMS_MAX_SESSIONS=10
XHS_SMS_MAX_CODE_ATTEMPTS=5
# 扫码等待默认 180 秒，短信与扫码共用会话数量和清理配置。
XHS_QR_SESSION_TIMEOUT_SECONDS=180
# 浏览器插件手动导入 Cookie 的独立密钥；留空禁用，请配置随机长密钥。
XHS_COOKIE_IMPORT_TOKEN=
# 抖音浏览器 Cookie 同步密钥，独立于小红书；留空禁用。
DOUYIN_COOKIE_IMPORT_TOKEN=
