# FastAPI 只读取此处的 APP_ENV，再加载 .env.dev 或 .env.prod
APP_ENV=dev

# 以下凭证仅供 scripts/legacy_cli.py 与旧版直播入口使用，FastAPI 不读取
DY_COOKIES=''
DY_LIVE_COOKIES=''
DY_TICKET=''
DY_TS_SIGN=''
DY_CLIENT_CERT=''
DY_PRIVATE_KEY=''

# FastAPI 请改用 .env.dev.example 或 .env.prod.example

# 小红书 PC API：启用前先将 crawler_cookie.remark 扩为 TEXT
XHS_ENABLED=true
XHS_MAX_CONCURRENT_REQUESTS=2
XHS_ACCOUNT_COOLDOWN_SECONDS=300
XHS_SNAPSHOT_INTERVAL_SECONDS=60
XHS_SMS_SESSION_TIMEOUT_SECONDS=300
XHS_SMS_SESSION_RETENTION_SECONDS=300
XHS_SMS_RESEND_INTERVAL_SECONDS=60
XHS_SMS_MAX_SESSIONS=10
XHS_SMS_MAX_CODE_ATTEMPTS=5
# 扫码等待默认 180 秒，短信与扫码共用会话数量和清理配置。
XHS_QR_SESSION_TIMEOUT_SECONDS=180
