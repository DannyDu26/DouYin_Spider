# 生产环境；部署时复制为 .env.prod
APP_ENV=prod

# 生产多账号凭证数据库
MYSQL_HOST=120.92.180.132
MYSQL_PORT=33306
MYSQL_DATABASE=auto_crawler
CRAWLER_PROJECT_ID=22
MYSQL_USER=
MYSQL_PASSWORD=

# 可信内网环境显式禁用 MySQL TLS
MYSQL_SSL_CA=
MYSQL_SSL_CERT=
MYSQL_SSL_KEY=
MYSQL_SSL_DISABLED=true
MYSQL_CONNECT_TIMEOUT_SECONDS=10
MYSQL_READ_TIMEOUT_SECONDS=30
MYSQL_WRITE_TIMEOUT_SECONDS=30
MYSQL_POOL_RECYCLE_SECONDS=1800
MYSQL_TIME_ZONE=+08:00

# API 并发与账号冷却
MAX_CONCURRENT_REQUESTS=2
MAX_CONCURRENT_REQUESTS_PER_ACCOUNT=1
# 生产环境保持关闭，避免普通调用方选择账号
ENABLE_TEST_ACCOUNT_PINNING=false
ACCOUNT_COOLDOWN_SECONDS=300
# 同一凭证累计冷却达到此次数后移出账号池并删除数据库记录，0 表示关闭
ACCOUNT_COOLDOWN_FAILURE_LIMIT=3
ACCOUNT_ACQUIRE_TIMEOUT_SECONDS=30
ACCOUNT_REFRESH_INTERVAL_SECONDS=300

# 抖音上游 HTTP 配置
DOUYIN_CONNECT_TIMEOUT_SECONDS=10
DOUYIN_READ_TIMEOUT_SECONDS=30
DOUYIN_CA_BUNDLE=

# 扫码会话配置
PLAYWRIGHT_BROWSER_CHANNEL=
QR_LOGIN_HEADLESS=false
QR_SESSION_TIMEOUT_SECONDS=180
QR_SMS_VERIFICATION_TIMEOUT_SECONDS=180
QR_SESSION_RETENTION_SECONDS=300
QR_PERSIST_TIMEOUT_SECONDS=30
QR_DEBUG_SCREENSHOT_ENABLED=false
