# 生产环境；部署时复制为 .env.prod
APP_ENV=prod

# 生产多账号凭证数据库
MYSQL_HOST=120.92.180.132
MYSQL_PORT=33306
MYSQL_DATABASE=auto_crawler
CRAWLER_PROJECT_ID=22
# 小红书账号凭证项目 ID
XHS_PROJECT_ID=42
MYSQL_USER=
MYSQL_PASSWORD=

# 可信内网环境显式禁用 MySQL TLS
MYSQL_SSL_CA=
MYSQL_SSL_CERT=
MYSQL_SSL_KEY=
MYSQL_SSL_DISABLED=true
MYSQL_CONNECT_TIMEOUT_SECONDS=10
MYSQL_READ_TIMEOUT_SECONDS=30
MYSQL_WRITE_TIMEOUT_SECONDS=30
MYSQL_POOL_RECYCLE_SECONDS=1800
MYSQL_TIME_ZONE=+08:00

# API 并发与账号冷却
MAX_CONCURRENT_REQUESTS=2
MAX_CONCURRENT_REQUESTS_PER_ACCOUNT=1
# search_videos 全局串行执行，相邻请求开始时间的最小间隔（秒）
SEARCH_VIDEOS_INTERVAL_SECONDS=2
# 生产环境保持关闭，避免普通调用方选择账号
ENABLE_TEST_ACCOUNT_PINNING=false
ACCOUNT_COOLDOWN_SECONDS=300
# 同一凭证累计冷却达到此次数后移出账号池并删除数据库记录，0 表示关闭
ACCOUNT_COOLDOWN_FAILURE_LIMIT=3
ACCOUNT_ACQUIRE_TIMEOUT_SECONDS=30
ACCOUNT_REFRESH_INTERVAL_SECONDS=300

# 抖音上游 HTTP 配置
DOUYIN_CONNECT_TIMEOUT_SECONDS=10
DOUYIN_READ_TIMEOUT_SECONDS=30
DOUYIN_CA_BUNDLE=

# 扫码会话配置
PLAYWRIGHT_BROWSER_CHANNEL=
QR_LOGIN_HEADLESS=false
QR_SESSION_TIMEOUT_SECONDS=180
QR_SMS_VERIFICATION_TIMEOUT_SECONDS=180
QR_SESSION_RETENTION_SECONDS=300
QR_PERSIST_TIMEOUT_SECONDS=30
QR_DEBUG_SCREENSHOT_ENABLED=false

# 小红书 PC API：启用前先将 crawler_cookie.remark 扩为 TEXT
XHS_ENABLED=true
XHS_MAX_CONCURRENT_REQUESTS=1
XHS_ACCOUNT_COOLDOWN_SECONDS=900
# 小红书业务请求统一节流：完成后等待 5～10 秒；入口和传输阶段各使用 30 秒等待预算。
XHS_REQUEST_INTERVAL_SECONDS=5
XHS_REQUEST_JITTER_SECONDS=5
XHS_REQUEST_QUEUE_TIMEOUT_SECONDS=30
XHS_UPSTREAM_MAX_RETRIES=2
XHS_UPSTREAM_BACKOFF_SECONDS=5
XHS_UPSTREAM_BACKOFF_MAX_SECONDS=60
XHS_SNAPSHOT_INTERVAL_SECONDS=60
XHS_SMS_SESSION_TIMEOUT_SECONDS=300
XHS_SMS_SESSION_RETENTION_SECONDS=300
XHS_SMS_RESEND_INTERVAL_SECONDS=60
XHS_SMS_MAX_SESSIONS=10
XHS_SMS_MAX_CODE_ATTEMPTS=5
# 扫码等待默认 180 秒，短信与扫码共用会话数量和清理配置。
XHS_QR_SESSION_TIMEOUT_SECONDS=180
# 浏览器插件手动导入 Cookie 的独立密钥；留空禁用，请配置随机长密钥。
XHS_COOKIE_IMPORT_TOKEN=
# 抖音浏览器 Cookie 同步密钥，独立于小红书；留空禁用。
DOUYIN_COOKIE_IMPORT_TOKEN=
