{
  "manifest_version": 3,
  "name": "短视频数据助手",
  "version": "0.1.21",
  "minimum_chrome_version": "116",
  "description": "使用当前 Chrome 平台登录状态采集搜索作品、用户作品和评论。",
  "permissions": [
    "activeTab",
    "cookies",
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "sidePanel",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "https://douyin.com/*",
    "https://*.douyin.com/*",
    "https://mssdk.bytedance.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "打开短视频数据助手"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
